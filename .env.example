# Environment Variables Template
# Copy to .env or .env.local and fill values.


# Client (Expo, used by lib/trpc.ts)
EXPO_PUBLIC_RORK_API_BASE_URL="http://localhost:8787"  # Base URL where backend/hono.ts is hosted (e.g. https://myapp.example.com)


# Backend: Third-party integrations
AYRSHARE_API_KEY=""             # Ayrshare API key for posting and analytics
SUPABASE_URL=""                 # Supabase project URL (e.g. https://abc.supabase.co)
SUPABASE_ANON_KEY=""            # Supabase anon key
CLERK_SECRET_KEY=""             # Clerk secret (if using Clerk auth server-side)
STRIPE_SECRET_KEY=""            # Stripe secret for server-side payments


# Optional Rork Toolkit/AI endpoints (if used)
# EXPO_PUBLIC_TOOLKIT_URL="https://toolkit.rork.com"  # Rork Toolkit base URL


# Notes
# - Never commit real secrets. Use per-environment secret stores.
# - EXPO_PUBLIC_* variables are embedded in the client bundle. Do not place secrets there.

